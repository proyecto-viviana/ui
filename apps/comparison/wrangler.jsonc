{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "proyecto-viviana-comparison",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-28",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
