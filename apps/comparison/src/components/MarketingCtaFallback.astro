---
import { comparisonCoveragePath } from "@comparison/data/site-meta";
---

<div class="s2-marketing-cta">
  <section class="s2-marketing-cta-section" aria-labelledby="marketing-cta-title">
    <div class="s2-marketing-cta-inner">
      <h2 id="marketing-cta-title" class="s2-marketing-cta-title">Ready to compare a component?</h2>
      <p class="s2-marketing-cta-lede">
        Open the catalogue, pick a slug, and drive React Spectrum and Solid Spectrum on the same
        route.
      </p>
      <div class="s2-marketing-cta-actions">
        <a class="s2-marketing-hero-button s2-marketing-hero-button--accent" href={comparisonCoveragePath}
          >Browse components</a
        >
        <a
          class="s2-marketing-hero-button s2-marketing-hero-button--secondary"
          href="https://www.npmjs.com/package/@proyecto-viviana/solid-spectrum">View on npm</a
        >
      </div>
    </div>
  </section>
</div>
