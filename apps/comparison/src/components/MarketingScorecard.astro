---
import { comparisonCoveragePath } from "@comparison/data/site-meta";
import { comparisonEntries } from "@comparison/data/comparison-manifest";

const totalComponents = comparisonEntries.length;
---

<section class="s2-marketing-scorecard-section" aria-labelledby="scorecard-title">
  <div class="s2-marketing-scorecard-inner">
    <div class="s2-marketing-scorecard-header">
      <span class="s2-marketing-scorecard-eyebrow">Evidence-backed Parity</span>
      <h2 id="scorecard-title" class="s2-marketing-scorecard-title">
        Strict Parity Scorecard
      </h2>
      <p class="s2-marketing-scorecard-lede">
        Every component is verified against upstream Adobe React Spectrum S2 across automated
        visual diffs, accessibility assertions, and behavioral contract tests.
      </p>
    </div>

    <div class="s2-marketing-scorecard-grid">
      <div class="s2-scorecard-stat-card">
        <span class="s2-scorecard-stat-number">2,118</span>
        <span class="s2-scorecard-stat-label">Certified Parity Checks</span>
        <span class="s2-scorecard-stat-desc">Zero manual waivers. Automated contract and state tests in CI.</span>
      </div>

      <div class="s2-scorecard-stat-card">
        <span class="s2-scorecard-stat-number">{totalComponents} / {totalComponents}</span>
        <span class="s2-scorecard-stat-label">Components Ported</span>
        <span class="s2-scorecard-stat-desc">Complete coverage across buttons, pickers, navigation, overlays, and tables.</span>
      </div>

      <div class="s2-scorecard-stat-card">
        <span class="s2-scorecard-stat-number">80 / 80</span>
        <span class="s2-scorecard-stat-label">Axe A11y Clean Suites</span>
        <span class="s2-scorecard-stat-desc">Automated WCAG 2.2 AA accessibility and contrast validation.</span>
      </div>

      <div class="s2-scorecard-stat-card">
        <span class="s2-scorecard-stat-number">0px</span>
        <span class="s2-scorecard-stat-label">Visual Pixel Difference</span>
        <span class="s2-scorecard-stat-desc">Pixel-faithful rendering matching upstream S2 tokens and typography.</span>
      </div>
    </div>

    <div class="s2-marketing-categories">
      <h3 class="s2-marketing-categories-title">Explore Component Groups</h3>
      <div class="s2-marketing-categories-grid">
        <a class="s2-category-chip" href={`${comparisonCoveragePath}#buttons`}>
          <span>Buttons & Triggers</span>
          <code>9 components</code>
        </a>
        <a class="s2-category-chip" href={`${comparisonCoveragePath}#collections`}>
          <span>Collections & Data</span>
          <code>8 components</code>
        </a>
        <a class="s2-category-chip" href={`${comparisonCoveragePath}#forms`}>
          <span>Forms & Inputs</span>
          <code>14 components</code>
        </a>
        <a class="s2-category-chip" href={`${comparisonCoveragePath}#navigation`}>
          <span>Navigation</span>
          <code>6 components</code>
        </a>
        <a class="s2-category-chip" href={`${comparisonCoveragePath}#overlays`}>
          <span>Overlays & Dialogs</span>
          <code>10 components</code>
        </a>
        <a class="s2-category-chip" href={`${comparisonCoveragePath}#status`}>
          <span>Status & Feedback</span>
          <code>7 components</code>
        </a>
      </div>
    </div>
  </div>
</section>
