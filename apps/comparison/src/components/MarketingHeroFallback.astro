---
import { reactSpectrumCatalogueSource } from "@comparison/data/react-spectrum-catalogue";
import { comparisonCoveragePath } from "@comparison/data/site-meta";
import ReactMount from "./ReactMount.astro";
import SolidMount from "./SolidMount.astro";
---

<div class="s2-marketing-hero">
  <section class="s2-marketing-hero-section" aria-labelledby="marketing-hero-title">
    <div class="s2-marketing-hero-inner">
      <div class="s2-marketing-hero-copy">
        <h1 id="marketing-hero-title" class="s2-marketing-hero-title">
          Spectrum 2, made for Solid.
        </h1>
        <p class="s2-marketing-hero-lede">
          A component-by-component parity harness for React Spectrum S2 and
          @proyecto-viviana/solid-spectrum.
        </p>
        <div class="s2-marketing-hero-actions">
          <a class="s2-marketing-hero-button s2-marketing-hero-button--accent" href={comparisonCoveragePath}
            >Browse components</a
          >
          <a
            class="s2-marketing-hero-button s2-marketing-hero-button--secondary"
            href={reactSpectrumCatalogueSource.url}>React Spectrum</a
          >
        </div>
      </div>
      <div class="s2-marketing-hero-visual">
        <div class="s2-marketing-hero-card">
          <div class="s2-marketing-hero-card-bar">
            <span class="s2-marketing-hero-card-dot"></span>
            <span class="s2-marketing-hero-card-dot"></span>
            <span class="s2-marketing-hero-card-dot"></span>
            <span class="s2-marketing-hero-card-title">Dual-Engine Fixture Specimen</span>
          </div>
          <div class="s2-marketing-hero-card-body">
            <div class="s2-marketing-hero-card-row s2-marketing-hero-card-row--engines">
              <div class="s2-marketing-hero-engine-col">
                <span class="s2-marketing-hero-engine-tag">React 19 · S2</span>
                <div class="s2-marketing-hero-engine-mount">
                  <ReactMount componentSlug="button" layer="styled" />
                </div>
              </div>
              <div class="s2-marketing-hero-engine-col">
                <span class="s2-marketing-hero-engine-tag s2-marketing-hero-engine-tag--solid">Solid 1.9 · Parity</span>
                <div class="s2-marketing-hero-engine-mount">
                  <SolidMount componentSlug="button" layer="styled" />
                </div>
              </div>
            </div>
            <div class="s2-marketing-hero-card-footer">
              <span class="s2-marketing-hero-pill s2-marketing-hero-pill--accent">Certified identical</span>
              <span class="s2-marketing-hero-pill">0px pixel delta</span>
              <span class="s2-marketing-hero-pill s2-marketing-hero-pill--quiet">2,118 test checks</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
