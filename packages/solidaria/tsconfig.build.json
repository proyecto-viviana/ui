{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@proyecto-viviana/solid-stately": ["../solid-stately/dist/index.d.ts"],
      "@proyecto-viviana/solid-stately/private/flags/flags": [
        "../solid-stately/dist/flags/flags.d.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "test-utils"]
}
